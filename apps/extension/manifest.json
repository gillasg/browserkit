{
  "manifest_version": 3,
  "name": "browserkit",
  "version": "0.1.0",
  "description": "Lets local agents and any MCP client use your real Chrome: your tabs, your logins, visibly.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "browserkit",
    "default_popup": "popup.html"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "debugger",
    "notifications",
    "userScripts",
    "scripting",
    "webNavigation",
    "downloads",
    "offscreen",
    "tabCapture",
    "tabGroups",
    "alarms",
    "history",
    "bookmarks",
    "cookies",
    "declarativeNetRequest",
    "contentSettings",
    "clipboardRead",
    "clipboardWrite",
    "proxy",
    "identity",
    "identity.email"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "sandbox": {
    "pages": ["code-sandbox.html"]
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
